# Firebase の設定値（Firebaseコンソール → プロジェクトの設定 → マイアプリ → SDK の設定と構成）
# Vercel では Settings → Environment Variables に同じ名前で登録する
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── AI先生（サーバ側だけで使う。VITE_ を付けないこと。ブラウザには渡りません）──
GROQ_API_KEY=
OPENAI_API_KEY=
# 任意：モデルを変えたいとき
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# 任意：ログイン済みの人だけAI先生を使えるようにする（VITE_FIREBASE_API_KEY と同じ値）
FIREBASE_API_KEY=
