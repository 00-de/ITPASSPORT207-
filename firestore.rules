rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 学習記録は本人だけが読み書きできる
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // それ以外はすべて拒否する
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
